$('#loginForm').addEventListener('submit',async e=>{e.preventDefault();$('#loginError').textContent='';try{await api('/login',{method:'POST',body:JSON.stringify({username:$('#username').value,password:$('#password').value})});await boot()}catch(x){$('#loginError').textContent=x.message}});
async function boot(){applyLanguage();try{const d=await api('/me');currentUser=d.user;sections=d.sections||[];$('#login').classList.add('hidden');$('#app').classList.remove('hidden');$('#displayName').textContent=currentUser.displayName;$('#roleName').textContent=tr(currentUser.role);$('#avatar').textContent=(currentUser.displayName||'F').slice(0,1);renderNav();openSection(sections.includes('dashboard')?'dashboard':sections[0]||'dashboard')}catch(e){$('#login').classList.remove('hidden');$('#app').classList.add('hidden')}}
function renderNav(){const order=['dashboard','staff','hr','attendance','leaves','payroll','ads','tasks','support','users','user_stats','finance','security','reports','maintenance','settings','approvals'];$('#nav').innerHTML=order.filter(x=>sections.includes(x)).map(x=>`<button data-sec="${x}" onclick="openSection('${x}')">${({dashboard:'◈',staff:'♙',hr:'▣',attendance:'◷',leaves:'▤',payroll:'＄',ads:'▧',tasks:'✓',support:'✉',users:'♧',user_stats:'▥',finance:'◇',security:'⬡',reports:'▤',maintenance:'⚙',settings:'☷',approvals:'✓'})[x]}　${tr(permLabels[x])}</button>`).join('')}
async function openSection(key){if(!sections.includes(key))return;$('#sidebar').classList.remove('open');document.querySelectorAll('.nav button').forEach(b=>b.classList.toggle('active',b.dataset.sec===key));currentSection=key;$('#pageTitle').textContent=tr(labels[key]?.[0]||key);$('#pageSub').textContent=tr(labels[key]?.[1]||'');const c=$('#content');c.innerHTML='<div class="panel empty">جارٍ تحميل البيانات...</div>';try{if(key==='dashboard')return await dashboard();if(key==='approvals')return await approvals();if(key==='staff')return await staff();if(key==='hr')return await hr();if(key==='attendance')return await attendance();if(key==='leaves')return await leaves();if(key==='payroll')return await payroll();if(key==='reports')return await reports();if(key==='user_stats')return await userStats();if(key==='security')return await generic('security');if(key==='maintenance')return await maintenance();if(key==='ads'||key==='tasks'||key==='support'||key==='users'||key==='user_stats'||key==='finance'||key==='settings')return generic(key)}catch(e){c.innerHTML=`<div class="panel empty">${esc(e.message)}</div>`}}
function stat(title,value){return `<div class="stat"><span>${tr(title)}</span><strong>${value??'—'}</strong></div>`}function panel(title,body,extra=''){return `<section class="panel"><div class="panel-head"><h3>${tr(title)}</h3>${tr(extra)}</div>${tr(body)}</section>`}function table(headers,rows){return `<div class="table-wrap"><table><thead><tr>${headers.map(h=>`<th>${tr(h)}</th>`).join('')}</tr></thead><tbody>${tr(rows||'')}</tbody></table></div>`}function empty(t='لا توجد بيانات لعرضها'){return `<div class="empty">${tr(t)}</div>`}
async function dashboard(){const d=await api('/dashboard');const x=d.data;let cards=[stat('طلبات إجازة معلقة',x.pendingLeaves),stat('مرشحو توظيف',x.pendingRecruitment),stat('الموظفون النشطون',x.staff),stat('تذاكر دعم مفتوحة',x.openTickets)];if(d.root){if(x.users!==undefined)cards.unshift(stat('إجمالي المستخدمين',x.users));cards.push(stat('طلبات سحب معلقة',x.withdrawals),stat('إثباتات مهام',x.pendingTasks),stat('قيود مالية',x.financeLedger));}$('#content').innerHTML=`<div class="grid">${cards.join('')}</div>${panel('حالة المنصة',`<div class="actions"><span class="tag ${x.maintenance?'warn':'good'}">${x.maintenance?'وضع الصيانة مفعل':'المنصة في وضع التشغيل'}</span><span class="tag good">تسجيل العمليات مفعل</span><span class="tag">نسخ احتياطي يومي</span></div>`)}${d.root?panel('تنبيه أمني',`<div class="notice">إحصائيات المستخدمين والتقارير الكاملة تظهر للأدمن الرئيسي أو لمن يحمل تصريحًا صريحًا. حسابات الموظفين لا تملك صلاحيات تلقائية.</div>`):''}`}
async function staff(){const d=await api('/staff');const rows=d.staff.map(s=>`<tr><td>${esc(s.displayName)}</td><td>${esc(s.username)}</td><td>${esc(s.role)}</td><td>${(s.permissions||[]).map(p=>`<span class="tag">${esc(permLabels[p]||p)}</span>`).join(' ')}</td><td><span class="tag ${s.active?'good':'bad'}">${s.active?'نشط':'موقوف'}</span></td><td><button class="btn secondary" onclick="toggleStaff('${s.id}',${!s.active})">${s.active?'إيقاف':'تفعيل'}</button></td></tr>`).join('');$('#content').innerHTML=panel('إنشاء حساب مسؤول',`<form id="staffForm"><div class="form-grid"><div class="field"><label>الاسم الظاهر</label><input name="displayName" required></div><div class="field"><label>اسم المستخدم (إنجليزي)</label><input name="username" pattern="[a-zA-Z0-9._-]{3,32}" required></div><div class="field"><label>المسمى الوظيفي</label><input name="role" placeholder="مسؤول دعم العملاء" required></div><div class="field"><label>Telegram ID (اختياري لربط صلاحيات البوت)</label><input name="telegramId" inputmode="numeric"></div><div class="field"><label>كلمة المرور (12 حرفًا على الأقل)</label><input name="password" type="password" minlength="12" required></div></div><label class="muted">الصلاحيات الممنوحة</label><div class="checks">${Object.entries(permLabels).filter(([p])=>p!=='reports').map(([p,l])=>`<label class="check"><input type="checkbox" name="permissions" value="${p}"> ${l}</label>`).join('')}</div><button class="btn">إنشاء حساب المسؤول</button></form>`)+panel('حسابات المسؤولين',table(['الاسم','اسم الدخول','الدور','الصلاحيات','الحالة','إجراء'],rows||''));$('#staffForm').onsubmit=createStaff}
async function createStaff(e){e.preventDefault();const f=new FormData(e.target);try{await api('/staff',{method:'POST',body:JSON.stringify({displayName:f.get('displayName'),username:f.get('username'),role:f.get('role'),telegramId:f.get('telegramId'),password:f.get('password'),permissions:f.getAll('permissions')})});toast('تم إنشاء الحساب');staff()}catch(x){toast(x.message)}}async function toggleStaff(id,active){try{await api('/staff/'+id,{method:'PATCH',body:JSON.stringify({active})});toast('تم تحديث الحساب');staff()}catch(e){toast(e.message)}}
async function hr(){const [e,r,a]=await Promise.all([api('/employees'),api('/recruitment'),api('/admin-applications')]);$('#content').innerHTML=panel('إضافة موظف',`<form id="employeeForm"><div class="form-grid"><div class="field"><label>اسم الموظف</label><input name="name" required></div><div class="field"><label>الوظيفة</label><input name="position" required></div><div class="field"><label>معرّف حساب المسؤول (اختياري)</label><input name="staffId"></div><div class="field"><label>الراتب الثابت</label><input name="salary" type="number" min="0" step="0.01" value="0"></div></div><button class="btn">إضافة الموظف</button></form>`)+panel('سجل الموظفين',table(['الاسم','الوظيفة','الراتب','الحالة'],e.employees.map(x=>`<tr><td>${esc(x.name)}</td><td>${esc(x.position)}</td><td>${Number(x.salary).toFixed(2)}</td><td><span class="tag good">${esc(x.status)}</span></td></tr>`).join('')||''))+panel('إضافة مرشح توظيف',`<form id="candidateForm"><div class="form-grid"><div class="field"><label>اسم المرشح</label><input name="name" required></div><div class="field"><label>البريد الإلكتروني</label><input name="email" type="email"></div><div class="field"><label>الوظيفة المطلوبة</label><input name="position" required></div><div class="field"><label>Telegram ID لإرسال إشعار القبول (اختياري)</label><input name="telegramId" inputmode="numeric"></div><div class="field"><label>ملف السيرة الذاتية CV (PDF / DOC / DOCX حتى 5MB)</label><input id="cvFile" type="file" accept=".pdf,.doc,.docx" required></div></div><button class="btn">إضافة للمراجعة</button></form>`)+panel('طلبات التوظيف',table(['رقم الطلب','المرشح','الوظيفة','CV','الحالة','إجراء'],r.candidates.map(x=>`<tr><td>${esc(x.id)}</td><td>${esc(x.name)}</td><td>${esc(x.position)}</td><td><a href="${esc(x.cvUrl)}" target="_blank" rel="noopener">فتح CV</a></td><td><span class="tag warn">${esc(x.status)}</span></td><td><select onchange="reviewCandidate('${x.id}',this.value)"><option value="">تغيير المرحلة</option>${x.status==='pending'?'<option value="cv_approved">اعتماد CV</option><option value="cv_rejected">رفض CV</option>':''}${x.status==='cv_approved'?'<option value="test">إرسال للاختبار</option>':''}${x.status==='test'?'<option value="passed">اجتاز الاختبار</option><option value="failed">لم يجتز</option>':''}${x.status==='passed'?'<option value="awaiting_management">رفع للاعتماد النهائي</option>':''}</select> ${x.status==='awaiting_management'&&currentUser.id==='root'?`<button class="btn" onclick="approveCandidate('${x.id}')">اعتماد نهائي</button>`:''}</td></tr>`).join('')||''))+panel('طلبات الانضمام لفريق الإدارة',table(['رقم الطلب','المتقدم','التخصص','CV','الحالة','مرحلة التوظيف'],a.applications.map(x=>`<tr><td>${esc(x.id)}</td><td>${esc(x.name)}<br><small>${esc(x.userId)}</small></td><td>${esc(x.role)}</td><td><a href="${esc(x.cvUrl)}" target="_blank" rel="noopener">فتح CV</a></td><td><span class="tag warn">${esc(x.status)}</span></td><td><select onchange="reviewAdminApplication('${x.id}',this.value)"><option value="">تغيير المرحلة</option>${x.status==='pending'?'<option value="cv_approved">اعتماد CV</option><option value="cv_rejected">رفض CV</option>':''}${x.status==='cv_approved'?'<option value="test">إرسال للاختبار</option>':''}${x.status==='test'?'<option value="passed">اجتاز الاختبار</option><option value="failed">لم يجتز</option>':''}${x.status==='passed'?'<option value="awaiting_management">رفع للإدارة النهائية</option>':''}</select> ${x.status==='awaiting_management'&&currentUser.id==='root'?`<button class="btn" onclick="approveAdminApplication('${x.id}')">اعتماد نهائي</button>`:''}</td></tr>`).join('')||''));$('#employeeForm').onsubmit=async ev=>{ev.preventDefault();const f=new FormData(ev.target);try{await api('/employees',{method:'POST',body:JSON.stringify(Object.fromEntries(f))});toast('تمت إضافة الموظف');hr()}catch(x){toast(x.message)}};$('#candidateForm').onsubmit=async ev=>{ev.preventDefault();const f=new FormData(ev.target);const file=$('#cvFile').files[0];if(!file){toast('ارفع ملف CV أولاً');return}try{const data=await new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(reader.result);reader.onerror=reject;reader.readAsDataURL(file)});const uploaded=await api('/cv-upload',{method:'POST',body:JSON.stringify({name:file.name,mime:file.type,data})});await api('/recruitment',{method:'POST',body:JSON.stringify({name:f.get('name'),email:f.get('email'),position:f.get('position'),telegramId:f.get('telegramId'),cvUrl:uploaded.cvUrl})});toast('تم رفع CV وتسجيل المرشح');hr()}catch(x){toast(x.message)}}}
async function reviewAdminApplication(id,status){if(!status)return;try{await api('/admin-applications/'+id+'/review',{method:'POST',body:JSON.stringify({status})});toast('تم تحديث مرحلة التوظيف');hr()}catch(e){toast(e.message)}}async function approveAdminApplication(id){try{const d=await api('/admin-applications/'+id+'/final-approval',{method:'POST',body:'{}'});toast('تم اعتماد القبول. كود التحقق: '+d.approvalCode);hr()}catch(e){toast(e.message)}}
async function reviewCandidate(id,status){if(!status)return;try{await api('/recruitment/'+id+'/review',{method:'POST',body:JSON.stringify({status})});toast('تم تحديث مرحلة التوظيف');hr()}catch(e){toast(e.message)}}async function approveCandidate(id){try{const d=await api('/recruitment/'+id+'/final-approval',{method:'POST',body:'{}'});toast('تم الاعتماد. كود التحقق: '+d.approvalCode);hr()}catch(e){toast(e.message)}}
async function attendance(){const d=await api('/attendance');$('#content').innerHTML=panel('سجل الحضور التلقائي',table(['الموظف','التاريخ','وقت الدخول','وقت الخروج','الحالة','المصدر'],d.attendance.map(x=>`<tr><td>${esc(x.name)}</td><td>${esc(x.date)}</td><td>${new Date(x.checkIn).toLocaleTimeString('ar-EG')}</td><td>${x.checkOut?new Date(x.checkOut).toLocaleTimeString('ar-EG'):'—'}</td><td><span class="tag good">${esc(x.status)}</span></td><td>${esc(x.source)}</td></tr>`).join('')||''))}
async function leaves(){const d=await api('/leaves');$('#content').innerHTML=panel('طلبات الإجازات',table(['الموظف','من','إلى','السبب','الحالة','القرار'],d.leaves.map(x=>`<tr><td>${esc(x.staffName)}</td><td>${esc(x.startDate)}</td><td>${esc(x.endDate)}</td><td>${esc(x.reason)}</td><td><span class="tag ${x.status==='approved'?'good':x.status==='rejected'?'bad':'warn'}">${esc(x.status)}</span></td><td>${x.status==='pending'&&x.staffId!==currentUser.id?`<button class="btn" onclick="leaveDecision('${x.id}','approved')">قبول</button> <button class="btn danger" onclick="leaveDecision('${x.id}','rejected')">رفض</button>`:'—'}</td></tr>`).join('')||''))+panel('تقديم طلب إجازة',`<form id="leaveForm"><div class="form-grid"><div class="field"><label>من تاريخ</label><input name="startDate" type="date" required></div><div class="field"><label>إلى تاريخ</label><input name="endDate" type="date" required></div></div><div class="field"><label>السبب</label><textarea name="reason" required></textarea></div><button class="btn">إرسال الطلب</button></form>`);$('#leaveForm').onsubmit=async e=>{e.preventDefault();try{await api('/leaves',{method:'POST',body:JSON.stringify(Object.fromEntries(new FormData(e.target))) });toast('تم إرسال طلب الإجازة');leaves()}catch(x){toast(x.message)}}}async function leaveDecision(id,action){try{await api('/leaves/'+id+'/decision',{method:'POST',body:JSON.stringify({action})});toast('تم حفظ القرار');leaves()}catch(e){toast(e.message)}}
async function payroll(){const d=await api('/payroll');$('#content').innerHTML=panel('إضافة راتب أو مكافأة',`<form id="payForm"><div class="form-grid"><div class="field"><label>معرّف الموظف</label><input name="employeeId" required></div><div class="field"><label>الفترة (YYYY-MM)</label><input name="period" type="month" value="${new Date().toISOString().slice(0,7)}" required></div><div class="field"><label>الراتب الثابت</label><input name="baseSalary" type="number" min="0" step="0.01" required></div><div class="field"><label>مكافأة الأداء</label><input name="bonus" type="number" min="0" step="0.01" value="0"></div></div><button class="btn">تسجيل للمراجعة</button></form>`)+panel('سجل الرواتب',table(['الموظف','الفترة','الراتب','المكافأة','الإجمالي','الحالة'],d.payroll.map(x=>`<tr><td>${esc(x.employeeId)}</td><td>${esc(x.period)}</td><td>${x.baseSalary}</td><td>${x.bonus}</td><td>${(x.baseSalary+x.bonus).toFixed(2)}</td><td><span class="tag warn">${esc(x.status)}</span></td></tr>`).join('')||''));$('#payForm').onsubmit=async e=>{e.preventDefault();try{await api('/payroll',{method:'POST',body:JSON.stringify(Object.fromEntries(new FormData(e.target)))});toast('تم تسجيل بند الرواتب');payroll()}catch(x){toast(x.message)}}}
async function reports(){const d=await api('/reports');$('#content').innerHTML=`<div class="grid">${d.users===null?'':stat('المستخدمون',d.users)}${stat('المسؤولون',d.staff)}${stat('الموظفون',d.employees)}${stat('طلبات الإجازة',d.leaves)}${stat('بنود الرواتب',d.payroll)}${stat('قيود دفتر الحسابات',d.ledger)}</div>${panel('خصوصية التقارير',`<div class="notice">هذه التقارير متاحة للأدمن الرئيسي فقط وفق إعدادات FORTRESS المعتمدة.</div>`)}`}
async function userStats(){const d=await api('/user-stats');$('#content').innerHTML=`<div class="grid">${stat('إجمالي المستخدمين',d.users)}</div>${panel('صلاحية مستقلة',`<div class="notice">ظهرت هذه البيانات لأن حسابك يحمل تصريحًا صريحًا لإحصائيات المستخدمين.</div>`)}`}
async function audit(){const d=await api('/audit');$('#content').innerHTML=panel('سجل العمليات الإدارية',table(['الوقت','المنفذ','العملية','الهدف','التفاصيل','بصمة'],d.rows.map(x=>`<tr><td>${new Date(x.time).toLocaleString('ar-EG')}</td><td>${esc(x.actorId)}</td><td>${esc(x.action)}</td><td>${esc(x.targetId)}</td><td>${esc(JSON.stringify(x.details||{}))}</td><td><code>${esc((x.hash||'').slice(0,12))}</code></td></tr>`).join('')||''))}
async function maintenance(){const d=await api('/maintenance');$('#content').innerHTML=panel('التحكم في وضع الصيانة',`<div class="notice">يمكن للأدمن الرئيسي أو المسؤول المفوض تفعيل الصيانة. لا يمنح هذا التصريح صلاحية الاطلاع على تقارير المستخدمين.</div><p>الحالة الحالية: <b>${d.enabled?'مفعّل':'غير مفعّل'}</b></p><button class="btn ${d.enabled?'danger':''}" onclick="setMaintenance(${!d.enabled})">${d.enabled?'إيقاف وضع الصيانة':'تفعيل وضع الصيانة'}</button>`)}async function setMaintenance(enabled){try{await api('/maintenance',{method:'POST',body:JSON.stringify({enabled})});toast('تم إرسال الطلب لاعتماد مسؤول آخر');maintenance()}catch(e){toast(e.message)}}
async function approvals(){const d=await api('/approvals');$('#content').innerHTML=panel('طلبات الاعتماد',table(['الطلب','نوع الإجراء','مقدم الطلب','الاعتمادات','الحالة','القرار'],d.approvals.map(x=>`<tr><td>${esc(x.id)}</td><td>${esc(x.action)} · ${esc(x.targetId)}</td><td>${esc(x.requestedBy)}</td><td>${(x.approvals||[]).length}/2</td><td><span class="tag ${x.status==='approved'?'good':x.status==='rejected'?'bad':'warn'}">${esc(x.status)}</span></td><td>${x.status==='pending'&&x.requestedBy!==currentUser.id?`<button class="btn" onclick="approvalDecision('${x.id}','approve')">اعتماد</button> <button class="btn danger" onclick="approvalDecision('${x.id}','reject')">رفض</button>`:'—'}</td></tr>`).join('')||''))}async function approvalDecision(id,decision){try{const d=await api('/approvals/'+id+'/decision',{method:'POST',body:JSON.stringify({decision})});toast(d.status==='approved'?'اكتمل الاعتماد المزدوج':d.status==='rejected'?'تم رفض الطلب':'تم تسجيل المراجعة');approvals()}catch(e){toast(e.message)}}
async function generic(key){
 if(key==='users'){const d=await api('/users');$('#content').innerHTML=panel('بحث وإدارة المستخدمين',`<form id="userSearch" class="actions"><input name="q" placeholder="ابحث بالاسم أو Telegram ID أو username" style="flex:1;min-width:220px;background:#081525;color:white;border:1px solid var(--line);padding:11px;border-radius:10px"><button class="btn">بحث</button></form>`)+panel('النتائج',table(['المستخدم','Telegram ID','الرصيد','الحالة','آخر نشاط','إجراء'],d.users.map(u=>`<tr><td>${esc(u.name)}<br><small class="muted">@${esc(u.username)}</small></td><td>${esc(u.id)}</td><td>${u.balance}</td><td>${u.isBanned?'<span class="tag bad">محظور</span>':u.isFrozen?'<span class="tag warn">مجمّد</span>':'<span class="tag good">نشط</span>'}</td><td>${esc(u.lastActive)}</td><td><button class="btn secondary" onclick="userAction('${u.id}','${u.isFrozen?'unfreeze':'freeze'}')">${u.isFrozen?'فك التجميد':'تجميد'}</button> <button class="btn danger" onclick="userAction('${u.id}','${u.isBanned?'unban':'ban'}')">${u.isBanned?'رفع الحظر':'حظر'}</button></td></tr>`).join('')||''));$('#userSearch').onsubmit=async e=>{e.preventDefault();const q=new FormData(e.target).get('q');const d=await api('/users?q='+encodeURIComponent(q));$('#content').querySelector('tbody').innerHTML=d.users.map(u=>`<tr><td>${esc(u.name)}</td><td>${esc(u.id)}</td><td>${u.balance}</td><td>${u.isBanned?'محظور':u.isFrozen?'مجمّد':'نشط'}</td><td>${esc(u.lastActive)}</td><td><button class="btn secondary" onclick="userAction('${u.id}','${u.isFrozen?'unfreeze':'freeze'}')">تجميد/فك</button> <button class="btn danger" onclick="userAction('${u.id}','${u.isBanned?'unban':'ban'}')">حظر/رفع</button></td></tr>`).join('')};return}
 if(key==='support'){const d=await api('/support');$('#content').innerHTML=panel('تذاكر الدعم',table(['رقم التذكرة','المستخدم','الرسالة','الحالة','التاريخ','رد'],d.tickets.map(t=>`<tr><td>${esc(t.id)}</td><td>${esc(t.userName)}<br><small>${esc(t.userId)}</small></td><td>${esc(t.message).slice(0,180)}</td><td><span class="tag">${esc(t.status)}</span></td><td>${esc(t.createdAt)}</td><td><button class="btn" onclick="replyTicket('${t.id}')">رد</button></td></tr>`).join('')||''));return}
 if(key==='tasks'){const d=await api('/tasks');$('#content').innerHTML=panel('إضافة مهمة',`<form id="taskForm"><div class="form-grid"><div class="field"><label>عنوان المهمة</label><input name="title" required></div><div class="field"><label>المكافأة USDT</label><input name="reward" type="number" min="0.0001" step="0.0001" required></div><div class="field"><label>رابط المهمة HTTPS</label><input name="link" type="url" required></div><div class="field"><label>الوصف</label><input name="description"></div></div><button class="btn">إضافة المهمة</button></form>`)+panel('المهام المنشورة',table(['المهمة','المكافأة','الرابط'],d.tasks.map(t=>`<tr><td>${esc(t.title)}</td><td>${t.reward} USDT</td><td><a href="${esc(t.link)}" target="_blank" rel="noopener">فتح الرابط</a></td></tr>`).join('')||''))+panel('إثباتات قيد المراجعة',table(['رقم الإثبات','المستخدم','المهمة','الإثبات','المكافأة','وقت الإرسال','قرار'],d.pending.map(t=>`<tr><td>${esc(t.id)}</td><td>${esc(t.userName)}</td><td>${esc(t.taskTitle)}</td><td>${esc(t.proofType==='photo'?'مرفق صورة':t.proofContent)}</td><td>${t.reward}</td><td>${esc(t.time)}</td><td><button class="btn" onclick="taskDecision('${t.id}','approve')">قبول</button> <button class="btn danger" onclick="taskDecision('${t.id}','reject')">رفض</button></td></tr>`).join('')||''));$('#taskForm').onsubmit=async e=>{e.preventDefault();try{await api('/tasks',{method:'POST',body:JSON.stringify(Object.fromEntries(new FormData(e.target)))});toast('تمت إضافة المهمة');generic('tasks')}catch(x){toast(x.message)}};return}
 if(key==='ads'){const d=await api('/ads');const b=d.adBlocks||{};$('#content').innerHTML=panel('إعدادات مواضع Adsun',`<div class="notice">كل موضع مستقل. مكافأة Reward لا تُعتمد إلا من callback الخادمي. لا تشارك أسرار Adsun في الواجهة.</div><form id="adsForm"><div class="form-grid">${[['banner','Banner'],['task','Task'],['rewarded','Rewarded'],['interstitial','Interstitial']].map(([k,l])=>`<div class="field"><label>${l} Block ID</label><input name="${k}" value="${esc(b[k]||'')}"></div>`).join('')}</div><button class="btn">حفظ مواضع الإعلانات</button></form>`);$('#adsForm').onsubmit=async e=>{e.preventDefault();try{await api('/ads',{method:'POST',body:JSON.stringify(Object.fromEntries(new FormData(e.target)))});toast('تم حفظ إعدادات Adsun')}catch(x){toast(x.message)}};return}
 if(key==='finance'){const d=await api('/finance');$('#content').innerHTML=panel('طلبات السحب المعلقة',table(['الطلب','المستخدم','المبلغ','المحفظة','الاعتمادات','الإجراء'],d.pendingWithdrawals.map(x=>`<tr><td>${esc(x.id)}</td><td>${esc(x.userName)} (${esc(x.userId)})</td><td>${x.amount} USDT</td><td><code>${esc(x.wallet)}</code></td><td>${(x.approvalIds||[]).length}/2</td><td>${x.status==='approved_for_payment'?`<input id="txid-${esc(x.id)}" placeholder="TXID 64 Hex" style="width:190px;background:#081525;color:white;border:1px solid var(--line);padding:8px;border-radius:8px"><button class="btn" onclick="completeWithdrawal('${x.id}')">تسجيل الدفع</button>`:x.decision==='approve'?`بانتظار الاعتماد الثاني <button class="btn" onclick="withdrawalDecision('${x.id}','approve')">اعتماد</button>`:x.decision==='reject'?`بانتظار الرفض الثاني <button class="btn danger" onclick="withdrawalDecision('${x.id}','reject')">رفض</button>`:`<button class="btn" onclick="withdrawalDecision('${x.id}','approve')">اعتماد</button> <button class="btn danger" onclick="withdrawalDecision('${x.id}','reject')">رفض</button>`}</td></tr>`).join('')||''))+panel('دفتر المعاملات المالي',table(['الوقت','المستخدم','النوع','المبلغ','المرجع','البصمة'],d.ledger.map(x=>`<tr><td>${esc(x.time)}</td><td>${esc(x.userId)}</td><td>${esc(x.type)}</td><td>${x.amount}</td><td>${esc(x.reference)}</td><td><code>${esc((x.hash||'').slice(0,12))}</code></td></tr>`).join('')||''))+`<div class="notice">لا يكتمل اعتماد السحب أو رفضه إلا بمراجعة مسؤولين مختلفين. إدخال TXID متاح بعد اكتمال الاعتماد المزدوج فقط.</div>`;return}
 if(key==='security'){const d=await api('/security');let html=panel('التنبيهات الأمنية',table(['الوقت','الحدث','المستخدم','التفاصيل','الخطورة'],d.alerts.map(x=>`<tr><td>${esc(x.time)}</td><td>${esc(x.eventType)}</td><td>${esc(x.userName)} (${esc(x.userId)})</td><td>${esc(x.details)}</td><td><span class="tag warn">${esc(x.riskScore)}</span></td></tr>`).join('')||''));if(currentUser.id==='root'){const a=await api('/audit');html+=panel('سجل جميع العمليات الإدارية',table(['الوقت','المنفذ','العملية','الهدف','البصمة'],a.rows.map(x=>`<tr><td>${esc(x.time)}</td><td>${esc(x.actorId)}</td><td>${esc(x.action)}</td><td>${esc(x.targetId)}</td><td><code>${esc((x.hash||'').slice(0,12))}</code></td></tr>`).join('')||''))}$('#content').innerHTML=html;return}
 const messages={user_stats:'هذه الصلاحية مستقلة ولا تُمنح تلقائيًا لأي مسؤول.',settings:'إعدادات الاستضافة والاتصالات الخارجية تُدار من متغيرات البيئة. لا تُعرض الأسرار في لوحة المتصفح.'};$('#content').innerHTML=panel(labels[key][0],`<div class="notice">${messages[key]||'هذه الوحدة محفوظة ضمن هيكل الإصدار وسيتم توسيعها بعد مراجعة ربطها بباقي مكونات المنصة.'}</div>`)
}
async function taskDecision(id,action){if(!confirm(action==='approve'?'تأكيد قبول المهمة وإضافة المكافأة؟':'تأكيد رفض إثبات المهمة؟'))return;try{await api('/tasks/'+id+'/decision',{method:'POST',body:JSON.stringify({action})});toast(action==='approve'?'تم قبول المهمة وإضافة المكافأة':'تم رفض إثبات المهمة');generic('tasks')}catch(e){toast(e.message)}}
async function withdrawalDecision(id,decision){try{const d=await api('/finance/'+id+'/decision',{method:'POST',body:JSON.stringify({decision})});toast(d.status==='approved_for_payment'?'اكتمل الاعتماد المزدوج؛ أدخل TXID':d.status==='rejected'?'تم رفض الطلب وإعادة الرصيد':'تم تسجيل الاعتماد الأول؛ يلزم مسؤول آخر');generic('finance')}catch(e){toast(e.message)}}async function completeWithdrawal(id){const txid=$('#txid-'+id)?.value||'';try{const d=await api('/finance/'+id+'/complete',{method:'POST',body:JSON.stringify({txid})});toast(d.message);generic('finance')}catch(e){toast(e.message)}}
async function userAction(id,action){if(!confirm('تأكيد تنفيذ الإجراء؟'))return;try{await api('/users/'+id+'/action',{method:'POST',body:JSON.stringify({action})});toast('تم إرسال الإجراء لاعتماد مسؤول آخر');generic('users')}catch(e){toast(e.message)}}async function replyTicket(id){const text=prompt('اكتب رد فريق الدعم:');if(!text)return;try{await api('/support/'+id+'/reply',{method:'POST',body:JSON.stringify({text})});toast('تم إرسال الرد');generic('support')}catch(e){toast(e.message)}}
async function logout(){try{await api('/logout',{method:'POST',body:'{}'})}catch{}location.reload()}boot();
</script></body></html>
